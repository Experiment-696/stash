{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stashapp.invalid/benchmark/summary.schema.json",
  "title": "Stash benchmark summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "correct", "metrics"],
  "properties": {
    "schema_version": { "const": "1" }, "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["prepared", "pass", "fail", "inconclusive"] }, "correct": { "type": "boolean" },
    "metrics": { "type": "object", "additionalProperties": { "$ref": "#/$defs/metric" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": { "metric": { "type": "object", "additionalProperties": false, "required": ["value", "unit", "lower_is_better"], "properties": { "value": { "type": "number" }, "unit": { "type": "string" }, "lower_is_better": { "type": "boolean" } } } }
}
